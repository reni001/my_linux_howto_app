#:import os os
#:import App kivy.app.App
#:import dp kivy.metrics.dp
#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior




<ClickableStatus@ButtonBehavior+BoxLayout>:
    canvas.before:
        Color:
            rgba: (0.8, 0.8, 0.8, 0.25) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

<StyledButton@Button>:
    background_normal: ''
    background_down: ''
    color: app.COLOR_WHITE

<AppMenu>:
    size_hint: (0.7, 0.6)  # Increased height for new button
    background_color: [0, 0, 0, 0]

    BoxLayout:
        orientation: 'vertical'
        padding: '20dp'
        spacing: '15dp'
        canvas.before:
            Color:
                rgba: app.COLOR_WHITE
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20,]

        # ✅ HEADER ROW (INSIDE main layout!)
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(45)
            spacing: dp(10)

            # ✅ LEFT: ICON
            Image:
                source: app.get_icon_path("howtolinux-icon.png")
                size_hint: None, None
                size: dp(32), dp(32)
                pos_hint: {"center_y": 0.5}

            # ✅ CENTER: TITLE
            Label:
                text: "APPLICATION MENU"
                color: app.COLOR_BLUE
                bold: True
                font_size: '16sp'
                halign: "left"
                valign: "middle"
                text_size: self.size

            # ✅ RIGHT: STATUS BLOCK (CLICKABLE + STABLE)
            ClickableStatus:
                orientation: "horizontal"
                size_hint_x: None
                width: dp(95)
                spacing: dp(5)

                background_normal: ''
                background_down: ''
                background_color: (0, 0, 0, 0) if self.state == 'normal' else (0.9, 0.9, 0.9, 0.3)

                on_release:
                    app.toggle_admin_mode()

                Image:
                    source: app.get_icon_path("status_green.png") if app.is_admin_mode() else app.get_icon_path("status_grey.png")
                    size_hint: None, None
                    size: dp(12), dp(12)
                    pos_hint: {"center_y": 0.5}

                Label:
                    text: "ADMIN" if app.is_admin_mode() else "USER"
                    color: app.COLOR_GREEN if app.is_admin_mode() else app.COLOR_TEXT_SOFT
                    font_size: '13sp'
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

        StyledButton:
            text: "About App"
            background_color: app.COLOR_GREY_DARK if self.state == 'normal' else app.COLOR_GREY_LIGHT
            size_hint_y: None
            height: '45dp'
            color: app.COLOR_WHITE
            bold: True
            on_release:
                root.dismiss()      # Closes the slide-out menu first
                app.show_about()     # Opens the new About popup

        StyledButton:
            text: "Open Database (Excel)"
            size_hint_y: None
            height: '45dp'
            background_normal: ''
            background_down: ''   # ✅ pressed highlight
            background_color: app.COLOR_BLUE if self.state == 'normal' else app.COLOR_BLUE_DARK_UI
            color: app.COLOR_WHITE
            bold: True
            on_release:
                root.dismiss()
                app.open_database()

        Button:
            text: "Open Assets Folder"
            size_hint_y: None
            height: '45dp'
            background_normal: ''
            background_down: ''   # ✅ pressed highlight
            background_color: app.COLOR_CYAN if self.state == 'normal' else app.COLOR_CYAN_DARK
            color: app.COLOR_WHITE
            bold: True
            on_release:
                root.dismiss()
                app.open_assets_folder()

        Button:
            text: "Add Topic (Admin)"
            disabled: not app.is_admin_mode()
            opacity: 1 if app.is_admin_mode() else 0.5
            size_hint_y: None
            height: '45dp'
            background_normal: ''
            background_down: ''   # ✅ pressed highlight
            background_color: app.COLOR_GREEN if self.state == 'normal' else app.COLOR_GREEN_DARK_UI
            color: app.COLOR_WHITE
            bold: True
            on_release:
                root.dismiss()
                app.open_new_topic()

        Button:
            text: app.update_text
            size_hint_y: None
            height: '45dp'
            background_normal: ''
            background_down: ''
            background_color: app.update_bg if self.state == 'normal' else app.COLOR_ORANGE_LIGHT_UI
            color: app.update_fg
            bold: True
            on_release:
                app.update_app_from_git()

            canvas.after:
                Color:
                    rgba: app.update_border
                Line:
                    rectangle: self.x + 1, self.y + 1, self.width - 2, self.height - 2
                    width: 2

        Button:
            id: sync_btn
            disabled: not app.is_admin_mode()
            opacity: 1 if app.is_admin_mode() else 0.5
            text: app.sync_text
            size_hint_y: None
            height: '45dp'
            background_normal: ''
            background_down: ''
            background_color: app.sync_bg if self.state == 'normal' else app.COLOR_ORANGE_DARK_UI
            color: app.sync_fg
            bold: True
            on_release:
                app.run_sync_script()

            canvas.after:
                Color:
                    rgba: app.sync_border
                Line:
                    rounded_rectangle: self.x + 1, self.y + 1, self.width - 2, self.height - 2, 0
                    width: 2

        Button:
            text: "Quit Application"
            size_hint_y: None
            height: '45dp'
            background_normal: ''
            background_down: ''   # ✅ pressed highlight
            background_color: app.COLOR_RED if self.state == 'normal' else app.COLOR_RED_DARK
            color: app.COLOR_WHITE
            bold: True
            on_release:
                root.dismiss()
                app.stop()
        Widget:

<StyledPanel@BoxLayout>:
    size_hint_y: None
    height: '65dp'
    padding: ['12dp', '8dp']
    canvas.before:
        Color:
            rgba: app.COLOR_PANEL
        Rectangle:
            pos: self.pos
            size: self.size

<JumpToTopButton@ButtonBehavior+Image>:
    source: app.get_icon_path("top.png")
    size_hint: None, None
    size: '52dp', '52dp'
    opacity: 0.9
    pos_hint: {'right': 0.98, 'y': 0.08}
    canvas.before:
        Color:
            rgba: app.COLOR_WHITE_SOFT
        Ellipse:
            pos: [self.pos[0] + dp(3), self.pos[1] + dp(3)]
            size: [self.size[0] - dp(6), self.size[1] - dp(6)]

# scroll down button
<ScrollDownButton@ButtonBehavior+Image>:
    source: app.get_icon_path("top.png")   # ✅ reuse same icon
    size_hint: None, None
    size: '52dp', '52dp'
    opacity: 0.9

    canvas.before:
        PushMatrix
        Rotate:
            angle: 180            # ✅ flip vertically
            origin: self.center
        Color:
            rgba: app.COLOR_WHITE_SOFT
        Ellipse:
            pos: self.pos
            size: self.size

    canvas.after:
        PopMatrix


<CategoryCard>:
    orientation: 'vertical'
    padding: '15dp'
    spacing: '5dp'
    size_hint_y: None
    height: '180dp'
    canvas.before:
        Color:
            rgba: [0, 0, 0, 0.15]
        RoundedRectangle:
            pos: [self.pos[0] + dp(2), self.pos[1] - dp(4)]
            size: self.size
            radius: [20,]
        Color:
            rgba: app.COLOR_PANEL if self.state == 'normal' else [179/255, 209/255, 255/255, 1]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20,]
    Image:
        source: root.icon_source
        size_hint_y: 0.9
        fit_mode: "contain"
    Label:
        text: root.name
        color: app.COLOR_BLUE
        bold: True
        font_size: '16sp'
        size_hint_y: 0.2

<EntryListItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '110dp'
    padding: '12dp'
    spacing: '15dp'
    canvas.before:
        Color:
            rgba: app.COLOR_WHITE if self.state == 'normal' else app.COLOR_GREY_HOVER
        RoundedRectangle:
            pos: [self.pos[0]+2, self.pos[1]+2]
            size: [self.size[0]-4, self.size[1]-4]
            radius: [10,]
    Image:
        source: root.icon_source
        size_hint_x: None
        width: '60dp'

    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.title
            color: app.COLOR_BLUE
            bold: True
            font_size: '18sp'
            halign: 'left'
            text_size: (self.width, None)
        Label:
            text: root.desc
            color: app.COLOR_TEXT_DARK
            font_size: '14sp'
            halign: 'left'
            text_size: (self.width, None)
            shorten: True

    BoxLayout:
        size_hint_x: None
        width: "90dp"
        spacing: "5dp"

        Button:
            disabled: not app.is_admin_mode()
            opacity: 1 if app.is_admin_mode() else 0.3
            background_normal: ''
            background_down: ''
            background_color: app.COLOR_TRANSPARENT
            size_hint: None, None
            size: "40dp", "40dp"
            on_release: app.edit_topic(root.data)

            Image:
                source: app.get_icon_path("edit.png")
                center_x: self.parent.center_x
                center_y: self.parent.center_y
                size: "28dp", "28dp"

        Button:
            disabled: not app.is_admin_mode()
            opacity: 1 if app.is_admin_mode() else 0.3
            background_normal: ''
            background_down: ''
            background_color: app.COLOR_TRANSPARENT
            size_hint: None, None
            size: "40dp", "40dp"
            on_release: app.delete_topic(root.data)

            Image:
                source: app.get_icon_path("delete.png")
                center_x: self.parent.center_x
                center_y: self.parent.center_y
                size: "28dp", "28dp"

<MenuScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            StyledPanel:
                # --- Top Panel Layout ---
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_x: None
                    width: self.minimum_width
                    padding: [dp(10), 0] # Internal padding for the panel

                    Image:
                        source: app.get_icon_path("howtolinux-icon.png")
                        size_hint: (None, None)
                        size: (dp(35), dp(35))
                        pos_hint: {'center_y': .5}

                    # --- SPACER WIDGET ---
                    Widget:
                        size_hint_x: None
                        width: dp(15) # Adjust this value to increase/decrease the gap

                    Label:
                        text: "LINUX HOW-TO"
                        color: app.COLOR_BLUE
                        bold: True
                        font_size: '22sp'
                        size_hint_x: None
                        width: self.texture_size[0]

                Widget: # This pushes the search button to the far right

                Button:
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '50dp'
                    on_release: root.manager.current = 'search'
                    Image:
                        source: app.get_icon_path("search.png")
                        center: self.parent.center
                        size: '32dp', '32dp'
            ScrollView:
                id: scroll_view
                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size

                GridLayout:
                    id: menu_container
                    cols: 2
                    padding: '25dp'
                    spacing: '25dp'
                    size_hint_y: None
                    height: self.minimum_height

            StyledPanel:
                height: '65dp'

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.open_app_menu()
                    Image:
                        source: app.get_icon_path("menu.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '28dp', '28dp'
                Widget:

                Label:
                    id: version_label_menu
                    text: "v0.0.0"
                    font_size: '12sp'
                    color: [0.3, 0.5, 0.8, 1]
                    size_hint_x: None
                    width: dp(60)
                Widget:

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.toggle_orientation()
                    Image:
                        source: app.get_icon_path("screenformate.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '28dp', '28dp'
        JumpToTopButton:
            on_release: scroll_view.scroll_y = 1

<SearchScreen>:
    BoxLayout:
        orientation: 'vertical' # This allows the panel to sit below the scrollview

        # --- Top Search Bar ---
        StyledPanel:
            height: '75dp'
            spacing: '10dp'
            Button:
                background_normal: ''
                background_color: app.COLOR_TRANSPARENT
                size_hint_x: None
                width: '50dp'
                on_release: root.go_back()
                Image:
                    source: app.get_icon_path("arrow_back.png")
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size: '32dp', '32dp'
            TextInput:
                id: search_input
                hint_text: "Search articles..."
                multiline: False
                size_hint_y: None
                height: '40dp'
                pos_hint: {'center_y': 0.5}
                on_text: root.filter_results(self.text)

        # --- Middle Results Area ---
        ScrollView:
            canvas.before:
                Color:
                    rgba: app.COLOR_GREY
                Rectangle:
                    pos: self.pos
                    size: self.size
            BoxLayout:
                id: results_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: '15dp'
                spacing: '10dp'

        # --- NEW Bottom Panel ---
        StyledPanel:
            height: '65dp'
            Button:
                background_normal: ''
                background_color: app.COLOR_TRANSPARENT
                size_hint_x: None
                width: '40dp'
                on_release: app.open_app_menu()
                Image:
                    source: app.get_icon_path("menu.png")
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size: '28dp', '28dp'

            Widget: # Spacer

            Label:
                id: version_label_search
                text: "v0.0.0"
                font_size: '12sp'
                color: [0.3, 0.5, 0.8, 1]
                size_hint_x: None
                width: dp(60)

            Widget: # Spacer

            Button:
                background_normal: ''
                background_color: app.COLOR_TRANSPARENT
                size_hint_x: None
                width: '40dp'
                on_release: app.toggle_orientation()
                Image:
                    source: app.get_icon_path("screenformate.png")
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size: '28dp', '28dp'


<DetailScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            StyledPanel:
                height: '85dp'
                spacing: '10dp'

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: root.manager.current = 'menu'

                    Image:
                        source: app.get_icon_path("arrow_back.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '32dp', '32dp'

                TextInput:
                    id: local_search
                    hint_text: "Search..."
                    multiline: False
                    size_hint_y: None
                    height: '45dp'
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: app.COLOR_WHITE_SOFT
                    on_text: root.load_content_from_cache(self.text)

            ScrollView:
                id: scroll_view

                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size

                BoxLayout:
                    id: list_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: '15dp'
                    spacing: '12dp'

            StyledPanel:
                height: '65dp'

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.open_app_menu()
                    Image:
                        source: app.get_icon_path("menu.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '28dp', '28dp'
                Widget:

                Label:
                    id: version_label_details
                    text: "v0.0.0"
                    font_size: '12sp'
                    color: [0.3, 0.5, 0.8, 1]
                    size_hint_x: None
                    width: dp(60)
                Widget:

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.toggle_orientation()
                    Image:
                        source: app.get_icon_path("screenformate.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '28dp', '28dp'

        JumpToTopButton:
            on_release: scroll_view.scroll_y = 1

<ArticleScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            StyledPanel:
                height: '75dp'
                spacing: '10dp'
                padding: [dp(10), 0] # Added padding to keep icons off the screen edge

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '50dp'
                    on_release: root.go_back()
                    Image:
                        source: app.get_icon_path("arrow_back.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '32dp', '32dp'

                Label:
                    text: "Documentation"
                    color: app.COLOR_BLUE
                    bold: True
                    font_size: '20sp'
                    halign: 'left'
                    size_hint_x: None # Don't let the label take all space
                    width: self.texture_size[0]
                    valign: 'middle'

                # --- THE MAGIC SPACER ---
                # This empty widget expands to push everything after it to the right
                Widget:

                # --- THE ICON ON THE RIGHT ---
                Image:
                    source: app.get_icon_path("howtolinux-icon.png")
                    size_hint: (None, None)
                    size: (dp(35), dp(35))
                    pos_hint: {'center_y': .5}

            ScrollView:
                id: scroll_view
                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size
                BoxLayout:
                    id: content_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: '25dp'
                    spacing: '25dp'

            # Bottom panel (Menu and Orientation)

            StyledPanel:
                id: bottom_bar
                height: '65dp'  # Property first!

                Button:         # Child widgets second
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.open_app_menu()
                    Image:
                        source: app.get_icon_path("menu.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '28dp', '28dp'
                Widget:

                Label:
                    id: version_label_article
                    text: "v0.0.0"
                    font_size: '12sp'
                    color: [0.3, 0.5, 0.8, 1]
                    size_hint_x: None
                    width: dp(60)
                Widget:

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.toggle_orientation()
                    Image:
                        source: app.get_icon_path("screenformate.png")
                        center_x: self.parent.center_x
                        center_y: self.parent.center_y
                        size: '28dp', '28dp'

        JumpToTopButton:
            on_release: scroll_view.scroll_y = 1


<AddTopicScreen>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"

            # Top bar (Article-like)
            StyledPanel:
                size_hint_y: None
                height: '75dp'
                spacing: '10dp'
                padding: [dp(10), 0]

                BoxLayout:
                    orientation: "horizontal"

                    # ✅ LEFT: back button
                    Button:
                        background_normal: ''
                        background_color: app.COLOR_TRANSPARENT
                        size_hint_x: None
                        width: '50dp'
                        on_release: app.root.current = 'menu'
                        Image:
                            source: app.get_icon_path("arrow_back.png")
                            center: self.parent.center
                            size: '32dp', '32dp'

                    # ✅ CENTER: title (with spacer trick)
                    Widget:

                    Label:
                        text: "Editing Topic" if root.edit_mode else "Add Topic"
                        color: app.COLOR_BLUE
                        bold: True
                        font_size: '20sp'
                        size_hint_x: None                  # ✅ important
                        width: dp(180)                    # ✅ fixed width → no expansion
                        halign: "center"
                        valign: "middle"
                        text_size: (self.width, None)     # ✅ disables wrapping

                    Widget:

                    # ✅ RIGHT: topic icon + cancel button
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: None
                        width: "90dp"
                        spacing: dp(6)
                        pos_hint: {"center_y": 0.5}   # ✅ THIS FIXES VERTICAL ALIGNMENT

                        # ✅ Topic icon
                        Image:
                            id: header_icon
                            source: app.get_icon_path("howtolinux-icon.png")  # default
                            size_hint: None, None
                            size: dp(42), dp(42)
                            allow_stretch: True
                            keep_ratio: True
                            pos_hint: {"center_y": 0.5}   # ✅ ALIGN WITH BUTTON

                        # ✅ Cancel button
                        Button:
                            size_hint: None, None
                            size: "42dp", "42dp"
                            pos_hint: {"center_y": 0.5}   # ✅ ALIGN WITH BUTTON
                            background_normal: app.get_icon_path("cancel.png")
                            background_down: app.get_icon_path("cancel.png")
                            background_color: app.COLOR_WHITE
                            border: 0,0,0,0
                            text: ""
                            on_release: root.cancel_edit()


            # Scroll area with grey background
            ScrollView:
                id: form_scroll
                do_scroll_x: False
                do_scroll_y: True

                size_hint_y: 1
                bar_width: 8

                # ✅ important: allow BOTH scrolling + content interaction
                scroll_type: ['bars', 'content']

                # ✅ smoother touch behavior
                scroll_distance: 10
                scroll_timeout: 200

                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size

                BoxLayout:
                    orientation: "vertical"
                    padding: ["25dp", "30dp", "25dp", "25dp"]
                    spacing: "15dp"
                    size_hint_y: None
                    height: self.minimum_height

                    # ---- status ----
                    Label:
                        id: status_label
                        text: ""
                        color: (1, 0, 0, 1)
                        size_hint_y: None
                        height: "28dp"

                    # ---- topic fields (all ids Python uses) ----
                    Spinner:
                        id: category
                        text: "Click to choose category"
                        values: []
                        size_hint_y: None
                        height: "35dp"
                        background_normal: ''
                        background_color: app.COLOR_WHITE
                        color: [0.1, 0.25, 0.45, 1]
                        on_text: root.on_category_changed(self.text)

                    Spinner:
                        id: subcategory
                        text: "Select Subcategory"
                        values: []
                        size_hint_y: None
                        height: "35dp"
                        background_normal: ''
                        background_color: app.COLOR_WHITE
                        color: [0.1, 0.25, 0.45, 1]
                        on_text: root.on_subcategory_changed(self.text)

                    TextInput:
                        id: title
                        hint_text: "Title (required)"
                        multiline: False
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False

                    TextInput:
                        id: topic_id
                        hint_text: "Topic ID (optional, leave empty to auto-generate)"
                        multiline: False
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False

                    TextInput:
                        id: description
                        hint_text: "Description"
                        multiline: True
                        size_hint_y: None
                        height: max(self.minimum_height, dp(120))
                        write_tab: False

                    TextInput:
                        id: urls
                        hint_text: "URLs (comma separated)"
                        multiline: False
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False

                    TextInput:
                        id: cat_icon
                        hint_text: "Category Icon filename (auto)"
                        multiline: False
                        readonly: True
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False

                    TextInput:
                        id: sub_icon
                        hint_text: "Subcategory Icon filename (auto)"
                        multiline: False
                        readonly: True
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False

                    TextInput:
                        id: topic_icon
                        on_text: root.on_topic_icon_change(self.text)
                        hint_text: "Topic Icon filename (optional)"
                        multiline: False
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False

                    BoxLayout:
                        size_hint_y: None
                        height: "35dp"
                        spacing: "10dp"

                        TextInput:
                            id: icon_path
                            hint_text: "Icon file path (optional)"
                            multiline: False
                            size_hint_y: None
                            height: "35dp"
                            write_tab: False

                        Button:
                            text: "Browse"
                            background_normal: ''
                            background_down: ''
                            background_color: app.COLOR_BLUE
                            color: app.COLOR_WHITE
                            bold: True
                            on_release: root.pick_icon()

                    # ---- steps section ----
                    Label:
                        text: "STEPS FOR THIS TOPIC"
                        color: app.COLOR_BLUE
                        bold: True
                        size_hint_y: None
                        height: "28dp"

                    ScrollView:
                        size_hint_y: None
                        height: min(steps_container.height, dp(200))   # ✅ dynamic height
                        bar_width: 8

                        GridLayout:   # ✅ NOW INSIDE ScrollView
                            id: steps_container
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "6dp"
                            padding: "2dp"

                    TextInput:
                        id: step_order
                        hint_text: "Step Number (integer, required)"
                        multiline: False
                        input_filter: "int"
                        padding: [10, 10]
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False


                    TextInput:
                        id: step_headline
                        hint_text: "Main Header (optional)"
                        multiline: False
                        padding: [10, 10]
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False


                    TextInput:
                        id: step_header2
                        hint_text: "Header 2 (optional)"
                        multiline: False
                        padding: [10, 10]
                        size_hint_y: None
                        height: "35dp"
                        write_tab: False


                    TextInput:
                        id: step_instruction
                        hint_text: "Instruction (required)"
                        multiline: True
                        size_hint_y: None
                        height: "110dp"
                        write_tab: False


                    TextInput:
                        id: step_code
                        hint_text: "Code_Snippet (optional)"
                        multiline: True
                        size_hint_y: None
                        height: "90dp"
                        write_tab: False


                    TextInput:
                        id: step_notes
                        hint_text: "Notes (optional)"
                        multiline: True
                        size_hint_y: None
                        height: "80dp"
                        write_tab: False


                    Widget:
                        size_hint_y: None
                        height: "60dp"


            # Bottom bar (optional, consistent)
            StyledPanel:
                size_hint_y: None
                height: '65dp'
                spacing: "8dp"
                padding: ["8dp", "8dp"]

                # ✅ LEFT: menu icon (fixed width)
                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '40dp'
                    on_release: app.open_app_menu()
                    Image:
                        source: app.get_icon_path("menu.png")
                        center: self.parent.center
                        size: '28dp', '28dp'

                # ✅ RIGHT: action buttons grouped
                BoxLayout:
                    spacing: "6dp"

                    Button:
                        text: "Add Step"
                        background_normal: ''
                        background_color: app.COLOR_BLUE_MEDIUM
                        color: app.COLOR_WHITE
                        bold: True
                        on_release: root.add_step_local()

                    Button:
                        text: "Remove Last"
                        background_normal: ''
                        background_color: app.COLOR_BLUE_MEDIUM
                        color: app.COLOR_WHITE
                        bold: True
                        on_release: root.remove_last_step()

                    Button:
                        text: "Clear"
                        background_normal: ''
                        background_color: app.COLOR_BLUE_MEDIUM
                        color: app.COLOR_WHITE
                        bold: True
                        on_release: root.clear_step_form()

                    Button:
                        text: "Save"
                        background_normal: ''
                        background_color: [0.2,0.6,0.2,1]
                        color: app.COLOR_WHITE
                        bold: True
                        on_release: root.save_topic()


        # ✅ FLOATING BUTTONS (LIKE ARTICLE SCREEN)

        # jump to top
        JumpToTopButton:
            pos_hint: {'right': 0.98, 'y': 0.15}
            opacity: 0.95
            on_release: form_scroll.scroll_y = 1

        # scroll down button
        ScrollDownButton:
            pos_hint: {'right': 0.98, 'y': 0.08}
            opacity: 0.95
            on_release:
                form_scroll.scroll_y -= 0.2


<AppInfoScreen>:
    BoxLayout:
        orientation: "vertical"

        StyledPanel:
            size_hint_y: None
            height: '75dp'
            spacing: '10dp'
            padding: [dp(10), 0]

            BoxLayout:
                orientation: "horizontal"

                # ✅ LEFT: back
                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: '50dp'
                    on_release: app.root.current = 'menu'
                    Image:
                        source: app.get_icon_path("arrow_back.png")
                        center: self.parent.center
                        size: '32dp', '32dp'

                Widget:

                # ✅ CENTER title
                Label:
                    text: "App Info"
                    color: app.COLOR_BLUE
                    bold: True
                    font_size: '20sp'
                    size_hint_x: 1
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Widget:

                # ✅ RIGHT: cancel (same as AddTopicScreen)
                AnchorLayout:
                    anchor_x: "right"
                    anchor_y: "center"
                    size_hint_x: None
                    width: "60dp"

                    Button:
                        size_hint: None, None
                        size: "42dp", "42dp"
                        background_normal: app.get_icon_path("cancel.png")
                        background_down: app.get_icon_path("cancel.png")
                        background_color: app.COLOR_WHITE
                        border: 0,0,0,0
                        text: ""
                        on_release: app.root.current = 'menu'


        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            size_hint_y: 1
            bar_width: 8

            canvas.before:
                Color:
                    rgba: app.COLOR_GREY
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                orientation: "vertical"
                padding: ["25dp", "30dp", "25dp", "25dp"]
                spacing: "15dp"
                size_hint_y: None
                height: self.minimum_height

                Label:
                    id: status_label
                    text: ""
                    color: 1,0,0,1
                    size_hint_y: None
                    height: "28dp"

                TextInput:
                    id: app_name
                    hint_text: "App Name"
                    multiline: False
                    size_hint_y: None
                    height: "40dp"

                TextInput:
                    id: version
                    hint_text: "Version (e.g. 1.2.0)"
                    multiline: False
                    size_hint_y: None
                    height: "40dp"

                TextInput:
                    id: last_update
                    hint_text: "Last Update"
                    multiline: False
                    size_hint_y: None
                    height: "40dp"

                TextInput:
                    id: developer
                    hint_text: "Developer"
                    multiline: False
                    size_hint_y: None
                    height: "40dp"

                TextInput:
                    id: description
                    hint_text: "Description"
                    multiline: True
                    height: max(self.minimum_height, dp(120))
                    size_hint_y: None


                Label:
                    text: "Changelog"
                    size_hint_y: None
                    height: "28dp"
                    color: app.COLOR_BLUE
                    bold: True

                ScrollView:
                    size_hint_y: None
                    height: "200dp"
                    bar_width: 8

                    TextInput:
                        id: changelog
                        multiline: True
                        size_hint_y: None
                        height: self.minimum_height

                Button:
                    text: "Save App Info"
                    size_hint_y: None
                    height: "50dp"
                    background_normal: ''
                    background_color: [0.2,0.6,0.2,1]
                    on_release: root.save_metadata()


<RotatableArrow>:
    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix

