#:import App kivy.app.App
#:import dp kivy.metrics.dp
#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior
#:import Clock kivy.clock.Clock
#:import Window kivy.core.window.Window

#:set INPUT_HEIGHT app.FONT_TEXT * 2.2
#:set SPACING app.FONT_TEXT * 0.8
#:set SPACING_SMALL app.FONT_TEXT * 0.5
#:set SPACING_LARGE app.FONT_TEXT * 1.2
#:set ICON_SIZE app.FONT_TEXT * 1.8
#:set ICON_SMALL app.FONT_TEXT * 1.2
#:set BUTTON_WIDTH app.FONT_TEXT * 12

<LazyImage@Image>:

<ClickableStatus@ButtonBehavior+BoxLayout>:
    canvas.before:
        Color:
            rgba: (0.8, 0.8, 0.8, 0.25) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

# ------ Button Definitions -------
<BaseButton@Button>:
    size_hint_y: None
    height: app.FONT_TEXT * 2.2
    font_size: app.FONT_BUTTON
    bold: True

    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: app.COLOR_WHITE
    font_name: "NotoSans"

    canvas.before:
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

<SmallButton@BaseButton>:
    size_hint_y: None
    height: INPUT_HEIGHT
    font_size: app.FONT_TEXT
    padding: [dp(10), 0]
    valign: "middle"
    halign: "center"
    text_size: self.size

<BrowseButton@SmallButton>:
    size_hint_x: None
    width: BUTTON_WIDTH
    text_size: self.size
    halign: "center"
    valign: "middle"
    background_color: app.COLOR_BLUE_MEDIUM if self.state == 'normal' else app.COLOR_BLUE_DARK_UI

#------Form definitions -------
<FormRow@BoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: INPUT_HEIGHT
    spacing: SPACING
    padding: [0, 0]

<FormInput@TextInput>:
    size_hint_y: None
    height: INPUT_HEIGHT
    multiline: False
    font_size: app.FONT_TEXT
    cursor_width: dp(2)
    write_tab: False
    padding: [dp(10), dp(8), dp(10), dp(8)]

<ReadonlyFormInput@FormInput>:
    readonly: True
    foreground_color: app.COLOR_TEXT_SOFT

<MultilineFormInput@TextInput>:
    size_hint_y: None
    size_hint_x: 1
    multiline: True
    font_size: app.FONT_TEXT
    cursor_width: dp(2)
    write_tab: False
    padding: [dp(10), dp(10), dp(10), dp(10)]

    # ✅ CRITICAL FOR SCROLLING
    text_size: self.width, None
    height: max(INPUT_HEIGHT * 2.5, self.minimum_height)
    #height: min(max(INPUT_HEIGHT * 2.5, self.minimum_height), INPUT_HEIGHT * 6)

<FormSpinner@Spinner>:
    size_hint_y: None
    height: INPUT_HEIGHT
    background_normal: ''
    background_color: app.COLOR_WHITE
    color: [0.1, 0.25, 0.45, 1]

# ----------------------------
# GENERIC APP BUTTONS
# ----------------------------
<SecondaryButton@BaseButton>:
    background_color: app.COLOR_GREY_DARK if self.state == 'normal' else app.COLOR_GREY_LIGHT

<PrimaryButton@BaseButton>:
    background_color: app.COLOR_BLUE if self.state == 'normal' else app.COLOR_BLUE_DARK_UI

<SuccessButton@BaseButton>:
    background_color: app.COLOR_GREEN if self.state == 'normal' else app.COLOR_GREEN_DARK_UI

<SecondaryBlueButton@BaseButton>:
    background_color: app.COLOR_BLUE_MEDIUM if self.state == 'normal' else app.COLOR_GREY_LIGHT

<DangerButton@BaseButton>:
    background_color: app.COLOR_RED if self.state == 'normal' else app.COLOR_RED_DARK

# ----------------------------
# MENU BUTTONS ONLY
# ----------------------------
<MenuButton@BaseButton>:
    size_hint_y: None
    size_hint_x: 0.9
    pos_hint: {"center_x": 0.5}

    height: INPUT_HEIGHT * 0.9
    font_size: app.FONT_TEXT
    padding: [dp(12), dp(6)]

#------------------------
<MenuSectionLabel@Label>:
    size_hint_y: None
    size_hint_x: 0.9               # ✅ same width as buttons
    pos_hint: {"center_x": 0.5}   # ✅ center align

    height: app.FONT_TEXT * 1.2

    padding: [dp(6), 0]    # ✅ NEW → aligns with button text
    text_size: self.size

    halign: "left"
    valign: "middle"

    color: app.COLOR_TEXT_SOFT
    font_size: app.FONT_TEXT * 0.75

<MenuDivider@Widget>:
    size_hint_y: None
    size_hint_x: 0.9
    height: dp(3)
    pos_hint: {"center_x": 0.5}

    canvas.before:
        Color:
            rgba: app.COLOR_TEXT_SOFT
        Line:
            points: self.x, self.center_y, self.x + self.width, self.center_y
            width: 1

# ----------------------------
# ICON BUTTON - Disabled (transparent)
# ----------------------------
<IconButton@Button>:
    size_hint: None, None
    size: ICON_SIZE, ICON_SIZE
    pos_hint: {"center_y": 0.5}
    fit_mode: "contain"

#----------- Panel Definitions ------------------------
<StyledPanel@BoxLayout>:
    size_hint_y: None
    height: app.FONT_TEXT * 3.8
    padding: [dp(12), dp(8)]
    canvas.before:
        Color:
            rgba: app.COLOR_PANEL
        Rectangle:
            pos: self.pos
            size: self.size

<BottomBar@StyledPanel>:
    height: app.FONT_TEXT * 3.8
    spacing: dp(8)
    padding: [dp(12), dp(8)]

    # LEFT ICON
    IconButton:
        source: app.get_icon_path("menu.png")
        on_release:
            app.open_app_menu()

    # LEFT SPACER
    Widget:

    # CENTER CONTENT
    BoxLayout:
        orientation: "horizontal"
        size_hint_x: 1          # ✅ IMPORTANT: use full width again
        spacing: SPACING_SMALL

        Label:
            text: app.version_string
            font_size: app.FONT_TEXT * 0.8
            color: app.COLOR_BLUE
            halign: "right"
            valign: "middle"
            text_size: None, None   # ✅ NO wrapping
            size_hint_x: None
            width: self.texture_size[0]

        Label:
            text: " | "
            font_size: app.FONT_TEXT * 0.8
            color: app.COLOR_TEXT_SOFT
            size_hint_x: None
            width: self.texture_size[0]

        Label:
            text: app.connection_status
            font_size: app.FONT_TEXT * 0.8
            bold: True
            color: app.COLOR_GREEN_DARK_UI if app.connection_status == "ONLINE" else app.COLOR_ORANGE_DARK_UI
            halign: "left"
            valign: "middle"
            text_size: None, None   # ✅ NO wrapping
            size_hint_x: None
            width: self.texture_size[0]

    # RIGHT SPACER
    Widget:

    # RIGHT ICON
    IconButton:
        source: app.get_icon_path("screenformate.png")
        size: app.FONT_TEXT * 1.8, app.FONT_TEXT * 1.8
        on_release:
            app.toggle_orientation()

<TopBar@StyledPanel>:
    size_hint_y: None
    height: app.FONT_TITLE * 3.4

    title: "TITLE"                  # ✅ dynamic title
    left_action: None               # ✅ optional ("back" or "")
    right_icon: ""                  # ✅ optional (icon filename)
    right_action: None              # ✅ optional function

    spacing: app.FONT_TEXT * 0.5
    padding: [app.FONT_TEXT * 0.8, app.FONT_TEXT * 0.4]

    # ---- LEFT BUTTON ----
    IconButton:
        source: app.get_icon_path("arrow_back.png")
        opacity: 1 if root.left_action else 0     # ✅ visible only if action exists
        disabled: not root.left_action            # ✅ prevent clicks when hidden

        on_release:
            root.left_action() if root.left_action else None

    # ---- TITLE ----
    Label:
        text: root.title
        color: app.COLOR_BLUE
        bold: True
        font_size: app.FONT_TITLE
        halign: 'center'
        valign: 'middle'
        text_size: self.size
        size_hint_x: 1   # ✅ KEY FIX → allows stretching

    # ---- RIGHT ICON ----
    IconButton:
        source: app.get_icon_path(root.right_icon) if root.right_icon else ""
        on_release:
            root.right_action() if root.right_action else None

<JumpToTopButton@ButtonBehavior+Image>:
    source: app.get_icon_path("top.png")
    size_hint: None, None
    size: ICON_SIZE * 1.4, ICON_SIZE * 1.4
    opacity: 0.9
    pos_hint: {'right': 0.98, 'y': 0.08}
    canvas.before:
        Color:
            rgba: app.COLOR_WHITE_SOFT
        Ellipse:
            pos: [self.pos[0] + dp(3), self.pos[1] + dp(3)]
            size: [self.size[0] - dp(6), self.size[1] - dp(6)]

# scroll down button
<ScrollDownButton@ButtonBehavior+Image>:
    source: app.get_icon_path("top.png")   # ✅ reuse same icon
    size_hint: None, None
    size: ICON_SIZE * 1.4, ICON_SIZE * 1.4
    opacity: 0.9

    canvas.before:
        PushMatrix
        Rotate:
            angle: 180            # ✅ flip vertically
            origin: self.center
        Color:
            rgba: app.COLOR_WHITE_SOFT
        Ellipse:
            pos: self.pos
            size: self.size

    canvas.after:
        PopMatrix

<AppMenu>:
    size_hint: None, None
    size: Window.width * 0.75, Window.height * 0.95

    background_color: [0, 0, 0, 0]

    BoxLayout:
        orientation: 'vertical'
        padding: [dp(20), dp(15), dp(20), dp(15)]
        spacing: SPACING
        size_hint_y: 1   # ✅ CRITICAL

        canvas.before:
            Color:
                rgba: app.COLOR_WHITE
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20,]

        # ✅ HEADER ROW (INSIDE main layout!)
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(45)
            spacing: SPACING

            # ✅ LEFT: ICON
            Image:
                source: app.get_icon_path("howtolinux-icon.png")
                size_hint: None, None
                size: ICON_SIZE * 0.8, ICON_SIZE * 0.8
                pos_hint: {"center_y": 0.5}

            # ✅ CENTER: TITLE
            Label:
                text: "APPLICATION MENU"
                color: app.COLOR_BLUE
                bold: True
                font_size: app.FONT_MENU_TITLE

                size_hint_x: 1   # ✅ takes available space

                halign: "left"
                valign: "middle"
                text_size: self.size
                shorten: True   # ✅ prevents overflow

            ClickableStatus:
                orientation: "horizontal"
                size_hint_x: None
                width: dp(115)
                spacing: dp(5)

                background_color: (0, 0, 0, 0) if self.state == 'normal' else (0.9, 0.9, 0.9, 0.3)

                on_release:
                    app.toggle_admin_mode()

                Image:
                    source: app.get_icon_path("status_green.png") if app.is_admin_mode() else app.get_icon_path("status_grey.png")
                    size_hint: None, None
                    size: dp(12), dp(12)
                    pos_hint: {"center_y": 0.5}

                Label:
                    text: "ADMIN" if app.is_admin_mode() else "USER"
                    color: app.COLOR_GREEN if app.is_admin_mode() else app.COLOR_TEXT_SOFT
                    font_size: app.FONT_MENU_STATUS
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

        ScrollView:
            size_hint_y: 1
            do_scroll_x: False
            do_scroll_y: True

            bar_width: dp(10)                 # ✅ thicker → easier to see
            bar_color: 0.3, 0.3, 0.3, 0.9     # ✅ dark and visible
            bar_inactive_color: 0.7, 0.7, 0.7, 0.4


            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: SPACING

                #MenuSectionLabel:
                #    text: "ABOUT"

                #-----
                MenuButton:
                    text: "About App"
                    background_color: app.COLOR_GREY_DARK if self.state == 'normal' else app.COLOR_GREY_LIGHT
                    on_release:
                        root.dismiss()
                        app.open_about_popup()

                MenuDivider:

                #-----
                MenuSectionLabel:
                    text: "TOOLS"

                MenuButton:
                    text: "Clean Unused Icons & Images"
                    background_color: app.COLOR_PURPLE if self.state == 'normal' else app.COLOR_PURPLE_DARK
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.confirm_clean_icons(), 0)

                MenuButton:
                    text: "Manage Categories"
                    background_color: app.COLOR_PURPLE if self.state == 'normal' else app.COLOR_PURPLE_DARK
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.open_category_dialog(), 0)

                MenuButton:
                    text: "Manage Subcategories"
                    background_color: app.COLOR_PURPLE if self.state == 'normal' else app.COLOR_PURPLE_DARK
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.open_subcategory_dialog(), 0)

                MenuDivider:

                # -----
                MenuSectionLabel:
                    text: "BACKUP"

                MenuButton:
                    text: app.backup_text
                    background_color: app.backup_bg if self.state == 'normal' else app.COLOR_PURPLE_DARK
                    color: app.backup_fg
                    on_release:
                        Clock.schedule_once(lambda dt: app.backup_current_data(), 0)

                    canvas.after:
                        Color:
                            rgba: app.backup_border
                        Line:
                            rectangle: self.x + 1, self.y + 1, self.width - 2, self.height - 2
                            width: 2

                MenuButton:
                    text: "Restore Backup"
                    background_color: app.COLOR_PURPLE if self.state == 'normal' else app.COLOR_PURPLE_DARK
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.show_restore_backup_dialog(), 0)

                MenuDivider:

                # -----
                MenuSectionLabel:
                    text: "NAVIGATION"

                MenuButton:
                    text: "Open Database"
                    background_color: app.COLOR_BLUE if self.state == 'normal' else app.COLOR_BLUE_DARK_UI
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.open_database(), 0)

                MenuButton:
                    text: "Open Assets Folder"
                    background_color: app.COLOR_BLUE if self.state == 'normal' else app.COLOR_BLUE_DARK_UI
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.open_assets_folder(), 0)

                MenuDivider:

                # -----
                MenuSectionLabel:
                    text: "CREATION"

                MenuButton:
                    text: "Add Topic"
                    background_color: app.COLOR_GREEN if self.state == 'normal' else app.COLOR_GREEN_DARK_UI
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.open_new_topic(), 0)

                MenuDivider:

                # -----
                MenuSectionLabel:
                    text: "SYSTEM"

                MenuButton:
                    text: app.update_text
                    background_color: app.update_bg if self.state == 'normal' else app.COLOR_ORANGE_LIGHT_UI
                    color: app.update_fg
                    on_release:
                        Clock.schedule_once(lambda dt: app.update_data(), 0)

                    canvas.after:
                        Color:
                            rgba: app.update_border
                        Line:
                            rectangle: self.x + 1, self.y + 1, self.width - 2, self.height - 2
                            width: 2

                MenuButton:
                    text: app.upgrade_text
                    background_color: app.upgrade_bg if self.state == 'normal' else app.COLOR_ORANGE_LIGHT_UI
                    color: app.upgrade_fg

                    on_release:
                        Clock.schedule_once(lambda dt: app.upgrade_app(), 0)

                    canvas.after:
                        Color:
                            rgba: app.upgrade_border
                        Line:
                            rectangle: self.x + 1, self.y + 1, self.width - 2, self.height - 2
                            width: 2

                MenuButton:
                    id: sync_btn
                    disabled: not app.is_admin_mode()
                    opacity: 1 if app.is_admin_mode() else 0.5
                    text: app.sync_text
                    bold: True

                    background_color: app.sync_bg if self.state == 'normal' else app.COLOR_ORANGE_LIGHT_UI
                    color: app.sync_fg

                    on_release:
                        Clock.schedule_once(lambda dt: app.run_sync_script(), 0)

                    canvas.after:
                        Color:
                            rgba: app.sync_border
                        Line:
                            rounded_rectangle: self.x + 1, self.y + 1, self.width - 2, self.height - 2, 0
                            width: 2

                MenuButton:
                    text: "Quit Application"
                    background_color: app.COLOR_RED if self.state == 'normal' else app.COLOR_RED_DARK
                    on_release:
                        root.dismiss()
                        Clock.schedule_once(lambda dt: app.stop(), 0)
        #Widget:

<CategoryCard>:
    orientation: 'vertical'
    padding: SPACING_SMALL
    spacing: SPACING_SMALL
    size_hint_y: None
    height: root.card_height

    canvas.before:
        Color:
            rgba: [0, 0, 0, 0.15]
        RoundedRectangle:
            pos: [self.pos[0] + dp(2), self.pos[1] - dp(4)]
            size: self.size
            radius: [20,]
        Color:
            rgba: app.COLOR_PANEL if self.state == 'normal' else [179/255, 209/255, 255/255, 1]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20,]

    # ✅ REAL widget
    LazyImage:
        source: root.icon_source
        size_hint: None, None
        size: root.icon_size, root.icon_size
        pos_hint: {"center_x": 0.5, "center_y": 0.65}
        fit_mode: "contain"

    # ✅ REAL widget
    Label:
        text: root.name
        color: app.COLOR_BLUE
        bold: True
        font_size: app.FONT_CATEGORY
        size_hint_y: None
        height: app.FONT_TEXT * 1.6

<EntryListItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: app.FONT_TEXT * 5
    padding: [SPACING_SMALL, SPACING * 0.9, SPACING_SMALL * 1.5, SPACING * 0.9]
    spacing: SPACING * 0.8

    canvas.before:
        Color:
            rgba: app.COLOR_WHITE if self.state == 'normal' else app.COLOR_GREY_HOVER
        RoundedRectangle:
            pos: [self.pos[0]+3, self.pos[1]+3]
            size: [self.size[0]-4, self.size[1]-4]
            radius: [10,]

    AnchorLayout:
        anchor_x: "left"
        anchor_y: "center"
        size_hint_x: None
        width: ICON_SIZE * 1.3 # ✅ left icon box column
        padding: [SPACING_SMALL * 0.8, 0, 0, 0]

        LazyImage:
            source: root.icon_source
            size_hint: None, None
            size: ICON_SIZE * 1.6, ICON_SIZE * 1.6
            fit_mode: "contain"

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 1

        # ✅ TITLE ROW (WITH LOCAL MARK)
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            #width: app.FONT_TEXT * 1.6   # reserved space
            height: app.FONT_TEXT * 1.3
            spacing: SPACING_SMALL

            Image:
                source: app.get_icon_path("local.png")
                size_hint: None, None
                size: app.FONT_TEXT * 1.3, app.FONT_TEXT * 1.3
                opacity: 1 if root.data.get("source") == "user" else 0

            Label:
                text: root.title
                color: app.COLOR_BLUE
                bold: True
                font_size: app.FONT_TITLE
                halign: 'left'
                text_size: (self.width, None)
                shorten: True
                max_lines: 1

        # ✅ DESCRIPTION
        BoxLayout:
            orientation: "horizontal"
            spacing: 0

            Widget:
                size_hint_x: None
                width: app.FONT_TEXT * 1.6   # SAME AS TITLE OFFSET

            Label:
                text: root.desc
                color: app.COLOR_TEXT_DARK
                font_size: app.FONT_TEXT
                halign: 'left'
                text_size: (self.width, None)
                shorten: True
                max_lines: 2

    BoxLayout:
        orientation: "horizontal"
        size_hint_x: None
        spacing: SPACING_SMALL
        padding: [0, dp(6), SPACING_SMALL, dp(6)]
        pos_hint: {"right": 0.9}

        # ✅ PROMOTE / DEMOTE
        IconButton:
            size: ICON_SIZE * 0.9, ICON_SIZE * 0.9

            opacity: 1 if app.is_admin_mode() else 0
            disabled: not app.is_admin_mode()

            source: app.get_icon_path("upload.png") if root.data.get("source") == "user" else app.get_icon_path("download.png")

            on_release:
                app.promote_topic(root.data) if root.data.get("source") == "user" else app.demote_topic(root.data)

        # ✅ EDIT
        IconButton:
            size: ICON_SIZE * 0.9, ICON_SIZE * 0.9

            disabled: not (app.is_admin_mode() or root.data.get("source") == "user")
            opacity: 1 if (app.is_admin_mode() or root.data.get("source") == "user") else 0.3

            source: app.get_icon_path("edit.png")

            on_release: app.edit_topic(root.data)

        # ✅ DELETE
        IconButton:
            size: ICON_SIZE * 0.9, ICON_SIZE * 0.9

            disabled: not (app.is_admin_mode() or root.data.get("source") == "user")
            opacity: 1 if (app.is_admin_mode() or root.data.get("source") == "user") else 0.3

            source: app.get_icon_path("delete.png")

            on_release: app.delete_topic(root.data)

#----------- Screens --------------
<MenuScreen>:
    FloatLayout:

        BoxLayout:
            orientation: 'vertical'

            TopBar:
                title: "LINUX HOW-TO"
                left_action: None   # ✅ hides back button
                right_icon: "search.png"
                right_action: lambda: setattr(root.manager, "current", "search")

            ScrollView:
                id: scroll_view
                do_scroll_x: False
                do_scroll_y: True

                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size

                GridLayout:
                    id: menu_container
                    cols: 2
                    padding: [dp(20), dp(20)]
                    spacing: [dp(20), dp(20)]
                    size_hint_y: None
                    height: self.minimum_height

            BottomBar:
                id: bottom_menu

        JumpToTopButton:
            on_release: scroll_view.scroll_y = 1

<SearchScreen>:
    BoxLayout:
        orientation: 'vertical' # This allows the panel to sit below the scrollview

        # --- Top Search Bar ---
        StyledPanel:
            height: app.FONT_TITLE * 3.4

            BoxLayout:
                orientation: "horizontal"
                spacing: app.FONT_TEXT * 0.5
                padding: [app.FONT_TEXT *0.8, app.FONT_TEXT * 0.4]

                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint: None, None
                    size: app.FONT_TITLE * 2, app.FONT_TITLE * 2
                    pos_hint: {"center_y": 0.5}
                    on_release: root.go_back()

                    Image:
                        source: app.get_icon_path("arrow_back.png")
                        size: app.FONT_TITLE * 2, app.FONT_TITLE * 2
                        center_x: self.parent.center_x   # ✅ CRITICAL
                        center_y: self.parent.center_y   # ✅ CRITICAL

                TextInput:
                    id: search_input
                    hint_text: "Search articles..."
                    size_hint_x: 1              # ✅ CRITICAL FIX
                    multiline: False
                    size_hint_y: None
                    font_size: app.FONT_TEXT
                    height: app.FONT_TEXT * 2.2
                    pos_hint: {"center_y": 0.5}
                    on_text: root.filter_results(self.text)
                    background_color: app.COLOR_WHITE_SOFT


        # --- Middle Results Area ---
        ScrollView:
            canvas.before:
                Color:
                    rgba: app.COLOR_GREY
                Rectangle:
                    pos: self.pos
                    size: self.size
            BoxLayout:
                id: results_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(15)
                spacing: SPACING

        # --- NEW Bottom Panel ---

        BottomBar:
            id: bottom_search

<DetailScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            StyledPanel:
                height: app.FONT_TITLE * 3.4
                spacing: app.FONT_TEXT * 0.5

                IconButton:
                    source: app.get_icon_path("arrow_back.png")
                    on_release: root.manager.current = 'menu'

                TextInput:
                    id: local_search
                    hint_text: "Search..."
                    font_size: app.FONT_TEXT   # ✅ BIGGER TEXT
                    multiline: False
                    size_hint_y: None
                    height: app.FONT_TEXT * 2.2   # ✅ SCALES WITH FONT
                    pos_hint: {'center_y': 0.5}
                    background_normal: ''
                    background_color: app.COLOR_WHITE_SOFT
                    on_text: root.load_content_from_cache(self.text)

            ScrollView:
                id: scroll_view

                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size

                BoxLayout:
                    id: list_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [SPACING_LARGE * 1.1, SPACING_LARGE * 0.8, SPACING_LARGE * 1.1, SPACING_LARGE]
                    spacing: SPACING_LARGE * 1.2

            BottomBar:
                id: bottom_details

        JumpToTopButton:
            on_release: scroll_view.scroll_y = 1

<ArticleScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'

            TopBar:
                title: "Documentation"
                left_action: root.go_back
                right_icon: "howtolinux-icon.png"

            ScrollView:
                id: scroll_view
                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size
                BoxLayout:
                    id: content_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [SPACING_LARGE * 1.1, SPACING_LARGE,                            SPACING_LARGE * 1.1, SPACING_LARGE * 1.2]
                    spacing: SPACING_LARGE * 1.2


            # Bottom panel (Menu and Orientation)

            BottomBar:
                id: bottom_bar

        JumpToTopButton:
            on_release: scroll_view.scroll_y = 1

<AddTopicScreen>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"

            # Top bar (Article-like)
            StyledPanel:
                size_hint_y: None
                height: app.FONT_TITLE * 3.4
                spacing: SPACING
                padding: [dp(10), 0]

                BoxLayout:
                    orientation: "horizontal"

                    # ✅ LEFT: back button
                    Button:
                        background_normal: ''
                        background_color: app.COLOR_TRANSPARENT
                        size_hint_x: None
                        width: app.FONT_TEXT * 3
                        on_release: app.root.current = app.previous_screen
                        Image:
                            source: app.get_icon_path("arrow_back.png")
                            center: self.parent.center
                            size: ICON_SIZE * 0.8, ICON_SIZE * 0.8

                    # ✅ CENTER: title (with spacer trick)
                    Widget:

                    Label:
                        text: "Editing Topic" if root.edit_mode else "Add Topic"
                        color: app.COLOR_BLUE
                        bold: True
                        font_size: app.FONT_TITLE
                        size_hint_x: None                  # ✅ important
                        width: app.FONT_TITLE * 8                    # ✅ fixed width → no expansion
                        halign: "center"
                        valign: "middle"
                        text_size: (self.width, None)     # ✅ disables wrapping

                    Widget:

                    # ✅ RIGHT: topic icon + cancel button
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: None
                        width: app.FONT_TEXT * 5
                        spacing: SPACING_SMALL
                        pos_hint: {"center_y": 0.5}   # ✅ THIS FIXES VERTICAL ALIGNMENT

                        # ✅ Topic icon
                        Image:
                            id: header_icon
                            source: app.get_icon_path("howtolinux-icon.png")  # default
                            size_hint: None, None
                            size: ICON_SIZE, ICON_SIZE
                            allow_stretch: True
                            keep_ratio: True
                            pos_hint: {"center_y": 0.5}   # ✅ ALIGN WITH BUTTON

                        # ✅ Cancel button
                        Button:
                            size_hint: None, None
                            size: ICON_SIZE, ICON_SIZE
                            pos_hint: {"center_y": 0.5}   # ✅ ALIGN WITH BUTTON
                            background_normal: app.get_icon_path("cancel.png")
                            background_down: app.get_icon_path("cancel.png")
                            background_color: app.COLOR_WHITE
                            border: 0,0,0,0
                            text: ""
                            on_release: root.cancel_edit()

            # Scroll area with grey background
            ScrollView:
                id: form_scroll
                do_scroll_x: False
                do_scroll_y: True

                size_hint_y: 1
                bar_width: 8

                # ✅ important: allow BOTH scrolling + content interaction
                scroll_type: ['bars', 'content']

                # ✅ smoother touch behavior
                scroll_distance: 10
                scroll_timeout: 200

                canvas.before:
                    Color:
                        rgba: app.COLOR_GREY
                    Rectangle:
                        pos: self.pos
                        size: self.size

                BoxLayout:
                    orientation: "vertical"
                    padding: [SPACING_LARGE, SPACING_LARGE * 1.2, SPACING_LARGE, SPACING_LARGE]
                    spacing: SPACING
                    size_hint_y: None
                    height: self.minimum_height

                    # ---- status ----
                    Label:
                        id: status_label
                        text: ""
                        markup: True
                        color: (1, 0, 0, 1)
                        size_hint_y: None
                        height: app.FONT_TEXT * 1.6

                    # ---- topic fields (all ids Python uses) ----
                    FormSpinner:
                        id: category
                        text: "Click to choose category"
                        values: []
                        on_text: root.on_category_changed(self.text)

                    FormSpinner:
                        id: subcategory
                        text: "Select Subcategory"
                        values: []
                        on_text: root.on_subcategory_changed(self.text)

                    FormInput:
                        id: title
                        hint_text: "Title (required)"
                        write_tab: False

                    FormInput:
                        id: topic_id
                        hint_text: "Topic ID (optional, leave empty to auto-generate)"

                    MultilineFormInput:
                        id: description
                        hint_text: "Description"

                    FormInput:
                        id: urls
                        hint_text: "URLs (comma separated)"

                    ReadonlyFormInput:
                        id: date_created
                        hint_text: "Date Created (auto)"

                    ReadonlyFormInput:
                        id: date_updated
                        hint_text: "Date Updated (auto)"

                    ReadonlyFormInput:
                        id: cat_icon
                        hint_text: "Category Icon filename (auto)"

                    ReadonlyFormInput:
                        id: sub_icon
                        hint_text: "Subcategory Icon filename (auto)"

                    FormInput:
                        id: topic_icon
                        on_text: root.on_topic_icon_change(self.text)
                        hint_text: "Topic Icon filename (optional)"

                    FormRow:
                        FormInput:
                            id: icon_path
                            hint_text: "Icon file path (optional)"

                        BrowseButton:
                            text: "Browse"
                            on_release: root.pick_icon()

                    # ---- steps section ----
                    Label:
                        text: "STEPS FOR THIS TOPIC"
                        color: app.COLOR_BLUE
                        font_size: app.FONT_SUBCATEGORY
                        bold: True
                        size_hint_y: None
                        height: app.FONT_TEXT * 1.6

                    ScrollView:
                        size_hint_y: None
                        height: min(steps_container.height, dp(200))   # ✅ dynamic height
                        bar_width: 8

                        GridLayout:   # ✅ NOW INSIDE ScrollView
                            id: steps_container
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: SPACING_SMALL
                            padding: dp(2)

                    FormInput:
                        id: step_order
                        hint_text: "Step Number (integer, required)"
                        input_filter: "int"

                    FormInput:
                        id: step_headline
                        hint_text: "Main Header (optional)"

                    FormInput:
                        id: step_header2
                        hint_text: "Header 2 (optional)"

                    MultilineFormInput:
                        id: step_instruction
                        hint_text: "Instruction (required)"

                    MultilineFormInput:
                        id: step_code
                        hint_text: "Code_Snippet (optional)"

                    # --- SCREENSHOT ---
                    FormRow:
                        FormInput:
                            id: step_screenshot
                            hint_text: "Screenshot filename (optional)"

                        BrowseButton:
                            text: "Browse"
                            on_release: root.pick_step_screenshot()

                    # --- STEP URLs ---
                    FormInput:
                        id: step_urls
                        hint_text: "Step URLs (comma separated)"
                        multiline: False

                    MultilineFormInput:
                        id: step_notes
                        hint_text: "Notes (optional)"

                    Widget:
                        size_hint_y: None
                        height: app.FONT_TEXT * 3

            # Bottom bar (optional, consistent)
            StyledPanel:
                size_hint_y: None
                height: app.FONT_TEXT * 3.8
                spacing: dp(8)
                padding: [dp(8), dp(8)]

                # ✅ LEFT: menu icon (fixed width)
                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: dp(40)
                    on_release: app.open_app_menu()
                    Image:
                        source: app.get_icon_path("menu.png")
                        center: self.parent.center
                        size: dp(28), dp(28)

                # ✅ RIGHT: action buttons grouped
                BoxLayout:
                    spacing: SPACING_SMALL

                    PrimaryButton:
                        text: "Add Step"
                        color: app.COLOR_WHITE
                        bold: True
                        on_release: root.add_step_local()

                    SecondaryBlueButton:
                        text: "Remove Last"
                        on_release: root.remove_last_step()

                    SecondaryBlueButton:
                        text: "Clear"
                        on_release: root.clear_step_form()

                    SuccessButton:
                        text: "Save"
                        color: app.COLOR_WHITE
                        bold: True
                        on_release: root.save_topic()

        # ✅ FLOATING BUTTONS (LIKE ARTICLE SCREEN)

        # jump to top
        JumpToTopButton:
            pos_hint: {'right': 0.98, 'y': 0.15}
            opacity: 0.95
            on_release: form_scroll.scroll_y = 1

        # scroll down button
        ScrollDownButton:
            pos_hint: {'right': 0.98, 'y': 0.08}
            opacity: 0.95
            on_release:
                form_scroll.scroll_y -= 0.2

<JsonViewerScreen>:
    BoxLayout:
        orientation: "vertical"

        TopBar:
            title: "JSON Data"
            left_action: lambda: setattr(root.manager, "current", "menu")

        ScrollView:
            TextInput:
                id: json_text
                readonly: True
                font_size: app.FONT_CODE
                size_hint_y: None
                height: self.minimum_height
                text_size: self.width, None

<AppInfoScreen>:
    BoxLayout:
        orientation: "vertical"

        StyledPanel:
            size_hint_y: None
            height: app.FONT_TITLE * 3.4
            spacing: app.FONT_TEXT * 0.6
            padding: [app.FONT_TEXT * 0.6, 0]

            BoxLayout:
                orientation: "horizontal"

                # ✅ LEFT: back
                Button:
                    background_normal: ''
                    background_color: app.COLOR_TRANSPARENT
                    size_hint_x: None
                    width: app.FONT_TITLE * 2
                    size: app.FONT_TITLE * 1.6, app.FONT_TITLE * 1.6

                    on_release: app.root.current = app.previous_screen
                    Image:
                        source: app.get_icon_path("arrow_back.png")
                        center: self.parent.center
                        size: ICON_SIZE * 0.8, ICON_SIZE * 0.8

                Widget:

                # ✅ CENTER title
                Label:
                    text: "App Info"
                    color: app.COLOR_BLUE
                    bold: True
                    font_size: app.FONT_TITLE
                    size_hint_x: 1
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Widget:

                # ✅ RIGHT: cancel (same as AddTopicScreen)
                AnchorLayout:
                    anchor_x: "right"
                    anchor_y: "center"
                    size_hint_x: None
                    width: app.FONT_TEXT * 3

                    Button:
                        size_hint: None, None
                        size: ICON_SIZE, ICON_SIZE
                        background_normal: app.get_icon_path("cancel.png")
                        background_down: app.get_icon_path("cancel.png")
                        background_color: app.COLOR_WHITE
                        border: 0,0,0,0
                        text: ""
                        on_release: app.root.current = app.previous_screen

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            size_hint_y: 1
            bar_width: 8

            canvas.before:
                Color:
                    rgba: app.COLOR_GREY
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                orientation: "vertical"
                spacing: app.FONT_TEXT * 0.9
                padding: [app.FONT_TEXT * 1.2, app.FONT_TEXT * 1.4, app.FONT_TEXT * 1.2, app.FONT_TEXT * 1.2]
                size_hint_y: None
                height: self.minimum_height

                Label:
                    id: status_label
                    text: ""
                    color: 1,0,0,1
                    size_hint_y: None
                    height: app.FONT_TEXT * 1.6

                FormInput:
                    id: app_name
                    hint_text: "App Name"

                FormInput:
                    id: version
                    hint_text: "Version (e.g. 1.2.0)"

                FormInput:
                    id: last_update
                    hint_text: "Last Update"

                FormInput:
                    id: developer
                    hint_text: "Developer"

                MultilineFormInput:
                    id: description
                    hint_text: "Description"

                Label:
                    text: "CHANGELOG"
                    size_hint_y: None
                    height: app.FONT_TEXT * 1.6
                    color: app.COLOR_BLUE
                    bold: True
                    font_size: app.FONT_SUBCATEGORY

                # -------- Preview (with icons) --------
                ScrollView:
                    size_hint_y: None
                    height: dp(220)
                    bar_width: 8

                    BoxLayout:
                        id: changelog_display
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)

                Widget:
                    size_hint_y: None
                    height: dp(8)

                # -------- EDITOR --------
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height

                    Label:
                        text: "Edit Changelog"
                        size_hint_y: None
                        height: app.FONT_TEXT * 1.5
                        color: app.COLOR_BLUE_MEDIUM
                        bold: True
                        font_size: app.FONT_TEXT

                    MultilineFormInput:
                        id: changelog
                        hint_text: "Edit changelog..."

        # -------- FIXED SAVE BAR --------
        StyledPanel:
            size_hint_y: None
            height: app.FONT_TEXT * 3.8
            padding: [dp(12), dp(8)]

            BoxLayout:
                size_hint_x: 1
                spacing: SPACING

                Widget:   # ✅ left spacer

                SuccessButton:
                    text: "Save App Info"
                    size_hint_x: None
                    width: app.FONT_TEXT * 15
                    on_release: root.save_metadata()

                Widget:   # ✅ right spacer

<RotatableArrow>:
    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas.after:
        PopMatrix
