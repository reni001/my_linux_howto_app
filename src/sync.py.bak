import subprocess
import os
import pandas as pd
import firebase_admin
from firebase_admin import credentials, db
import sys

print("--- Sync Script Starting ---")

# 1. SETUP FIREBASE
try:
    print("Checking for serviceAccountKey.json...")
    cred = credentials.Certificate("serviceAccountKey.json")

    if not firebase_admin._apps:
        print("Initializing Firebase connection...")
        firebase_admin.initialize_app(cred, {
            'databaseURL': 'https://linux-howto-8f441-default-rtdb.europe-west1.firebasedatabase.app/'
        })
    print("Firebase setup complete.")
except Exception as e:
    print(f"❌ Firebase Setup Error: {e}")
    sys.exit()

# 2. CONFIGURATION
excel_file = "data/main.xlsx"

def sync():
    try:
        print(f"Attempting to read file: {excel_file}")
        xls = pd.ExcelFile(excel_file)
        print(f"File found! Sheets available: {xls.sheet_names}")

        # --- A. SYNC TOPICS & STEPS ---
        df_topics = pd.read_excel(excel_file, sheet_name='topics')
        df_steps = pd.read_excel(excel_file, sheet_name='steps')

        print(f"Loaded {len(df_topics)} topics and {len(df_steps)} steps.")

        for df in [df_topics, df_steps]:
            for col in df.columns:
                if pd.api.types.is_datetime64_any_dtype(df[col]):
                    df[col] = df[col].dt.strftime('%Y-%m-%d')
                elif df[col].dtype == 'object':
                    df[col] = df[col].astype(str)

        topics_dict = df_topics.fillna("").to_dict(orient='records')
        steps_dict = df_steps.fillna("").to_dict(orient='records')

        # Cleanup artifacts
        topics_dict = [{k: (v if v != "nan" else "") for k, v in row.items()} for row in topics_dict]
        steps_dict = [{k: (v if v != "nan" else "") for k, v in row.items()} for row in steps_dict]

        # --- B. SYNC APP INFO (METADATA) ---
        metadata_dict = {}
        if 'AppInfo' in xls.sheet_names:
            print("Found 'AppInfo' sheet. Processing metadata...")
            df_info = pd.read_excel(excel_file, sheet_name='AppInfo')

            # Assuming Column A is 'Field' and Column B is 'Value'
            # This converts the rows into a key-value dictionary
            metadata_dict = dict(zip(df_info.iloc[:, 0], df_info.iloc[:, 1]))
            # Clean up nans in metadata
            metadata_dict = {k: (v if str(v) != "nan" else "") for k, v in metadata_dict.items()}

        # 3. UPLOAD TO FIREBASE
        print("Pushing data to Firebase...")
        db.reference('topics').set(topics_dict)
        print("✅ 'topics' uploaded successfully.")

        db.reference('steps').set(steps_dict)
        print("✅ 'steps' uploaded successfully.")

        if metadata_dict:
            db.reference('metadata').set(metadata_dict)
            print("✅ 'metadata' (AppInfo) uploaded successfully.")

        print("🚀 SUCCESS! Everything is synced.")

    except Exception as e:
        print(f"❌ Sync Error: {e}")

def sync_to_github(commit_message="Auto-sync from sync.py"):
    """Pushes local changes to GitHub automatically."""
    try:
        print("🚀 Starting GitHub synchronization...")
        subprocess.run(["git", "add", "."], check=True)
        result = subprocess.run(["git", "commit", "-m", commit_message], capture_output=True, text=True)

        if "nothing to commit" in result.stdout:
            print("✨ Everything is already up to date.")
        else:
            subprocess.run(["git", "push", "origin", "main"], check=True)
            print("✅ Successfully synced to GitHub!")
    except subprocess.CalledProcessError as e:
        print(f"❌ Git Sync failed: {e}")
    except FileNotFoundError:
        print("❌ Error: Git is not installed.")

if __name__ == "__main__":
    sync()
    print("--- Sync Process with firebase Finished ---")
    sync_to_github("Updated database and assets via sync.py")
    print("--- Sync Process with GitHub Finished ---")
