<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">

  <!-- Outer circle -->
  <circle cx="256" cy="256" r="235"
          fill="none"
          stroke="#3F6AB3"
          stroke-width="10"/>

  <!-- Mask to simulate torn paper -->
  <defs>
    <clipPath id="leftPiece">
      <path d="
        M0,0 L256,0
        L256,512 L0,512 Z" />
    </clipPath>

    <clipPath id="rightPiece">
      <path d="
        M256,0 L512,0
        L512,512 L256,512 Z" />
    </clipPath>
  </defs>

  <!-- LEFT piece (unaltered logo, clipped) -->
  <g clip-path="url(#leftPiece)">
    <path fill="#4C73B6" d="
      M128,384
      Q96,256 180,160
      Q256,96 332,160
      Q416,256 384,384
      Q256,420 128,384 Z"/>

    <!-- infinity shape left (original style preserved) -->
    <path fill="#ffffff" d="
      M180,260
      C160,200 220,180 250,225
      C280,270 340,250 330,200
      C320,160 260,150 230,180" />
  </g>

  <!-- RIGHT piece (unaltered logo, clipped) -->
  <g clip-path="url(#rightPiece)">
    <path fill="#4C73B6" d="
      M128,384
      Q96,256 180,160
      Q256,96 332,160
      Q416,256 384,384
      Q256,420 128,384 Z"/>

    <path fill="#ffffff" d="
      M332,200
      C350,260 290,300 260,260
      C220,210 170,240 180,300
      C190,340 260,350 300,310" />
  </g>

  <!-- Tear (realistic paper edge) -->
  <path d="
    M256 60
    L248 90
    L258 120
    L244 150
    L260 180
    L246 210
    L262 240
    L248 270
    L260 300
    L246 330
    L258 360
    L248 390
    L256 440"
    stroke="#ffffff"
    stroke-width="14"
    stroke-linejoin="round"
    stroke-linecap="round"
    fill="none"/>

</svg>
